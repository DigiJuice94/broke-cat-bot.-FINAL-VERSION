# BROKE CAT BOT V8 — SOL NATIVE
TRADING_MODE=paper
PAPER_BANKROLL_USD=11
MAX_POSITION_USD=2
MAX_DAILY_LOSS_USD=1
MIN_SCORE=90
POLL_SECONDS=30
DATA_DIR=/data
HELIUS_API_KEY=

# LIVE ONLY
LIVE_TRADING_ACK=I_UNDERSTAND_REAL_FUNDS_ARE_AT_RISK
JUPITER_API_KEY=
BS58_PRIVATE_KEY=
# V8.7: bot chooses its own live trade size. It may use up to the configured % of the wallet.
AUTO_POSITION_SIZING=true
AUTO_SIZE_MIN_WALLET_PCT=10
AUTO_SIZE_MAX_WALLET_PCT=100
AUTO_SIZE_MIN_TRADE_USD=0.50
# Always keep a tiny SOL buffer so the wallet can pay network fees and exit.
MIN_SOL_RESERVE=0.0015
# Legacy only; used if AUTO_POSITION_SIZING=false
LIVE_POSITION_USD=2
STOP_LOSS_PCT=15
TAKE_PROFIT_PCT=50
TRAIL_ARM_PCT=25
TRAIL_DRAWDOWN_PCT=12

# OPTIONAL X
X_POSTING_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# NEW V8.4 EXTERNAL BUNDLE DATA SOURCE
# Get this key from Solana Tracker Data API. This is NOT Helius.
SOLANA_TRACKER_API_KEY=
SOLANA_TRACKER_TIMEOUT_MS=8000
BUNDLE_SUPPLY_MEDIUM_PCT=5
BUNDLE_SUPPLY_HIGH_PCT=20

# V8.5 position recovery
RECOVERY_LOOKBACK_HOURS=72

# V8.6 position safety
ORPHAN_HOLDING_BLOCK_USD=0.50
# On Railway, mount a persistent volume at /data and set DATA_DIR=/data for durable cost-basis/trade history.
# DATA_DIR=/data

# V8.10 market data / discovery
GECKOTERMINAL_ENABLED=true
GECKOTERMINAL_PAGES=2
GECKOTERMINAL_CANDIDATE_LIMIT=40
GECKOTERMINAL_TIMEOUT_MS=10000
DEXSCREENER_FALLBACK=true
