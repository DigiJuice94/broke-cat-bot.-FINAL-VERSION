# BROKE CAT BOT V8 — SOL NATIVE
TRADING_MODE=paper
PAPER_BANKROLL_USD=11
MAX_POSITION_USD=2
MAX_DAILY_LOSS_USD=1
MIN_SCORE=90
POLL_SECONDS=30
DATA_DIR=/data
HELIUS_API_KEY=

# LIVE ONLY
LIVE_TRADING_ACK=I_UNDERSTAND_REAL_FUNDS_ARE_AT_RISK
JUPITER_API_KEY=
BS58_PRIVATE_KEY=
LIVE_POSITION_USD=2
MIN_SOL_RESERVE=0.003
STOP_LOSS_PCT=15
TAKE_PROFIT_PCT=50
TRAIL_ARM_PCT=25
TRAIL_DRAWDOWN_PCT=12

# OPTIONAL X
X_POSTING_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# V8.4 AXIOM-STYLE BUNDLE RISK (our own on-chain heuristic)
# <5% low; 5-10% small penalty; 10-20% larger penalty; >=20% high/reject.
BUNDLE_SUPPLY_MEDIUM_PCT=5
BUNDLE_SUPPLY_ELEVATED_PCT=10
BUNDLE_SUPPLY_HIGH_PCT=20
LAUNCH_TX_LIMIT=100
LAUNCH_WINDOW_SECONDS=180
MIN_LAUNCH_TX_FOR_CONFIDENCE=4
CLUSTER_WALLET_THRESHOLD=4
CLUSTER_REPEAT_THRESHOLD=3
MAX_FUNDING_WALLET_CHECKS=8
FUNDING_HISTORY_LIMIT=30
FUNDING_LOOKBACK_SECONDS=86400
SHARED_FUNDER_HIGH_WALLETS=4
